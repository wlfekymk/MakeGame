*.VC.db

# 빌드 결과물
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics 등
crashlytics-build.properties

# Asset 메타데이터 캐시
sysinfo.txt

# OS 파일
.DS_Store
Thumbs.db
