# ===== Unity 표준 .gitignore =====

# Unity가 자동 생성하는 폴더 (커밋 불필요)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/

# Visual Studio / Rider / VSCode 캐시
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# 빌드 결과물
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics 등
crashlytics-build.properties

# Asset 메타데이터 캐시
sysinfo.txt

# OS 파일
.DS_Store
Thumbs.db

# Git 인증 정보 (토큰 등) - 절대 커밋 금지
.git-credentials
.git-ssh/
repo.bundle

# Unity 크래시 복구 시 자동 생성되는 임시 씬 (프로젝트 콘텐츠 아님)
Assets/_Recovery/
Assets/_Recovery.meta
